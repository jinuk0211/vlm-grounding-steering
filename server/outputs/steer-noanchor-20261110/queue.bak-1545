# 11:27 interleave: L24a2 confirmation and the blur-contrast screen (L18a2bl rows 0-69: 27.1 vs ns 35.7, recall +3.2, CHAIR_i lower)
gemma zzsmoke_blur 0 2 --lam 0.5 --pen 0.25 --steer resid --layers 18 --alpha 2 --ctrl blur
gemma L24a2 100 200 --lam 0.5 --pen 0.25 --steer resid --layers 24 --alpha 2
gemma L18a2bl 0 100 --lam 0.5 --pen 0.25 --steer resid --layers 18 --alpha 2 --ctrl blur
gemma L24a2 200 300 --lam 0.5 --pen 0.25 --steer resid --layers 24 --alpha 2
gemma L18a2bl 100 200 --lam 0.5 --pen 0.25 --steer resid --layers 18 --alpha 2 --ctrl blur
gemma L24a2 300 400 --lam 0.5 --pen 0.25 --steer resid --layers 24 --alpha 2
gemma L24a2 400 500 --lam 0.5 --pen 0.25 --steer resid --layers 24 --alpha 2
gemma L24a3 0 100 --lam 0.5 --pen 0.25 --steer resid --layers 24 --alpha 3
gemma L24a3 100 200 --lam 0.5 --pen 0.25 --steer resid --layers 24 --alpha 3
gemma L18a3 0 100 --lam 0.5 --pen 0.25 --steer resid --layers 18 --alpha 3
# 14:39 two-layer variant (small formula change: Eq. steer applied at layers 18 and 24, alpha 1.5 each)
# 15:38 user plan: belief a bit stronger (lam .75 pen .35) + this steering, then full ablation (w/o steering / belief / penalty).
#   step 1: Full and w/o steering at lam .75 pen .35 on rows 0-199 (does the steering gap survive?)
gemma L24a2m 0 100 --lam 0.75 --pen 0.35 --steer resid --layers 24 --alpha 2
gemma nsm 0 100 --lam 0.75 --pen 0.35 --steer none
gemma L24a2m 100 200 --lam 0.75 --pen 0.35 --steer resid --layers 24 --alpha 2
gemma nsm 100 200 --lam 0.75 --pen 0.35 --steer none
#   fallback ablation at the current setting (lam .5 pen .25): w/o belief, w/o penalty (Full=L24a2, w/o steering=ns exist, 500 rows)
gemma abl_nobelief_L24a2 0 100 --lam 0 --pen 0.25 --steer resid --layers 24 --alpha 2
gemma abl_nobelief_L24a2 100 200 --lam 0 --pen 0.25 --steer resid --layers 24 --alpha 2
gemma abl_nobelief_L24a2 200 300 --lam 0 --pen 0.25 --steer resid --layers 24 --alpha 2
gemma abl_nobelief_L24a2 300 400 --lam 0 --pen 0.25 --steer resid --layers 24 --alpha 2
gemma abl_nobelief_L24a2 400 500 --lam 0 --pen 0.25 --steer resid --layers 24 --alpha 2
