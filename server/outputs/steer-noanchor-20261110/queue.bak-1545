gemma abl_nopen_L24a2 100 200 --lam 0.5 --pen 0 --steer resid --layers 24 --alpha 2
gemma abl_nopen_L24a2 200 300 --lam 0.5 --pen 0 --steer resid --layers 24 --alpha 2
gemma abl_nopen_L24a2 300 400 --lam 0.5 --pen 0 --steer resid --layers 24 --alpha 2
gemma abl_nopen_L24a2 400 500 --lam 0.5 --pen 0 --steer resid --layers 24 --alpha 2
# 15:35 user: weak belief was deliberate; with the paper belief the steering effect should carry over -> test it: gemma L24 alpha 2 with lam 1 pen 0.5 on all 500 rows,
#   compared with the stored paper runs (abl_nosteer = -steering, rbd_full = TETHER L24 a1, base); placed before the gate screen
gemma L24a2b1 0 100 --lam 1 --pen 0.5 --steer resid --layers 24 --alpha 2
gemma L24a2b1 100 200 --lam 1 --pen 0.5 --steer resid --layers 24 --alpha 2
gemma L24a2b1 200 300 --lam 1 --pen 0.5 --steer resid --layers 24 --alpha 2
gemma L24a2b1 300 400 --lam 1 --pen 0.5 --steer resid --layers 24 --alpha 2
gemma L24a2b1 400 500 --lam 1 --pen 0.5 --steer resid --layers 24 --alpha 2
# 15:13 gate schedule (small change of s(t)): s = 1 - r(t) only where the previous step read the image less than the caption average (KL real||gray)
gemma zzsmoke_gate 0 2 --lam 0.5 --pen 0.25 --steer resid --layers 24 --alpha 3 --ssched gate
gemma L24a3g 0 100 --lam 0.5 --pen 0.25 --steer resid --layers 24 --alpha 3 --ssched gate
gemma L18a3 100 200 --lam 0.5 --pen 0.25 --steer resid --layers 18 --alpha 3
